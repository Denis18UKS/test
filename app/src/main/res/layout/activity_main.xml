<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧩  Puzzle Scan"
            android:textStyle="bold"
            android:textSize="21sp"
            android:textColor="@color/purple_dark" />

        <Button
            android:id="@+id/btn_reference"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Эталон"
            android:textAllCaps="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.05">

        <org.opencv.android.JavaCameraView
            android:id="@+id/camera_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.puzzlescan.app.ScanOverlayView
            android:id="@+id/scan_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/status_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="#D9000000"
            android:text="Наведите камеру на деталь"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_piece"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="Скан детали"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_fragment"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Скан фрагмента"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.95"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.puzzlescan.app.TargetImageView
            android:id="@+id/reference_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#E9E6F0"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="145dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="8dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/match_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ожидаю деталь"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/match_confidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Точность: —"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/match_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Метод: —"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/match_rotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Поворот: —"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/match_coords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Место: —"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:text="Нестандартная форма поддерживается: приложение выделяет реальный контур, а не предполагает классические зубцы пазла."
                android:textColor="#6A6570"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
